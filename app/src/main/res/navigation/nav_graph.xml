<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/TelaLogin">

    <fragment
        android:id="@+id/TelaLogin"
        android:name="com.example.projetoachadosperdidos.TelaLogin"
        android:label="Tela Login"
        tools:layout="@layout/tela_login">

        <action
            android:id="@+id/action_TelaLogin_to_TelaCadastro"
            app:destination="@id/TelaCadastro" />
        <action
            android:id="@+id/action_TelaLogin_to_TelaInicio"
            app:destination="@id/TelaInicio" />

    </fragment>
    <fragment
        android:id="@+id/TelaCadastro"
        android:name="com.example.projetoachadosperdidos.TelaCadastro"
        android:label="Tela Cadastro"
        tools:layout="@layout/tela_cadastro">

        <action
            android:id="@+id/action_TelaCadastro_to_TelaLogin"
            app:destination="@id/TelaLogin" />
    </fragment>

    <fragment
        android:id="@+id/TelaInicio"
        android:name="com.example.projetoachadosperdidos.TelaInicio"
        android:label="Tela Inicio"
        tools:layout="@layout/tela_inicio">

        <action
            android:id="@+id/action_TelaInicio_to_TelaPerfil"
            app:destination="@id/TelaPerfil" />
        <action
            android:id="@+id/action_TelaInicio_to_TelaLogin"
            app:destination="@id/TelaLogin" />
    </fragment>

    <fragment
        android:id="@+id/TelaPerfil"
        android:name="com.example.projetoachadosperdidos.TelaPerfil"
        android:label="Tela Início"
        tools:layout="@layout/tela_perfil">

        <action
            android:id="@+id/action_TelaPerfil_to_TelaEdicaoPerfil"
            app:destination="@id/TelaEdicaoPerfil" />
        <action
            android:id="@+id/action_TelaPerfil_to_TelaInicio"
            app:destination="@id/TelaInicio" />
    </fragment>

    <fragment
        android:id="@+id/TelaEdicaoPerfil"
        android:name="com.example.projetoachadosperdidos.TelaEdicaoPerfil"
        android:label="Tela Edição Perfil"
        tools:layout="@layout/tela_edicao_perfil">

        <action
            android:id="@+id/action_TelaEdicaoPerfil_to_TelaPerfil"
            app:destination="@id/TelaPerfil" />
    </fragment>
</navigation>