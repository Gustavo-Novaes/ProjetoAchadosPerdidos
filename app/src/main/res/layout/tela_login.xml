<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1FA"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".TelaLogin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- LOGO -->
        <ImageView
            android:layout_width="125dp"
            android:layout_height="125dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/logo_app"
            android:scaleType="fitCenter"
            android:contentDescription="Logo do aplicativo" />

        <!-- TÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bem-vindo de volta!"
            android:textColor="#493568"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Entre na sua conta e ajude a encontrar o que foi perdido."
            android:textColor="#796F85"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <!-- CAMPO USUÁRIO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usuário ou e-mail"
            android:textColor="#493568"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editTextUsuario"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_geral"
            android:hint="Digite seu login ou e-mail"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#30283B"
            android:textColorHint="#A49AAD"
            android:textSize="14sp"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginBottom="22dp"/>

        <!-- CAMPO SENHA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Senha"
            android:textColor="#493568"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editTextSenha"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_geral"
            android:hint="Digite sua senha"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#30283B"
            android:textColorHint="#A49AAD"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:singleLine="true"
            android:layout_marginBottom="30dp"/>

        <!-- BOTÃO LOGIN -->
        <Button
            android:id="@+id/buttonLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Entrar"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#493568"
            android:elevation="4dp"
            android:layout_marginBottom="24dp"/>

        <!-- CADASTRO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ainda não possui uma conta?"
            android:textColor="#796F85"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/buttonCadastrar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Criar minha conta"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#493568"
            android:textAllCaps="false"
            android:backgroundTint="#DCCFEB"
            android:layout_marginBottom="12dp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
