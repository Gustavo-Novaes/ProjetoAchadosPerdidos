<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1FA"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".TelaEdicaoPerfil">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Editar Perfil"
            android:textColor="#493568"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <!-- SUBTÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atualize suas informações pessoais e mantenha sua conta sempre atualizada."
            android:textColor="#796F85"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <!-- TELEFONE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telefone (opcional)"
            android:textColor="#493568"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editTextTelefone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_geral"
            android:hint="Digite seu telefone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#30283B"
            android:textColorHint="#A49AAD"
            android:textSize="14sp"
            android:inputType="phone"
            android:singleLine="true"
            android:layout_marginBottom="24dp"/>

        <!-- SENHA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nova senha"
            android:textColor="#493568"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editTextSenha"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_geral"
            android:hint="Digite sua nova senha"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#30283B"
            android:textColorHint="#A49AAD"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:singleLine="true"
            android:layout_marginBottom="24dp"/>

        <!-- CONFIRMAR SENHA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar nova senha"
            android:textColor="#493568"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editTextConfirmaSenha"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_geral"
            android:hint="Digite novamente sua senha"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#30283B"
            android:textColorHint="#A49AAD"
            android:textSize="14sp"
            android:inputType="textPassword"
            android:singleLine="true"
            android:layout_marginBottom="36dp"/>

        <!-- BOTÃO ATUALIZAR -->
        <Button
            android:id="@+id/buttonEditar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Salvar alterações"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="#493568"
            android:elevation="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- BOTÃO VOLTAR -->
        <Button
            android:id="@+id/buttonVoltar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Voltar"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#493568"
            android:textAllCaps="false"
            android:backgroundTint="#DCCFEB"
            android:layout_marginBottom="12dp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
